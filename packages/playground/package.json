{
  "name": "wat-lsp-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "mkdir -p public && cp node_modules/@emnudge/wat-lsp/dist/wasm/wat_lsp_rust_bg.wasm public/ && cp node_modules/@emnudge/wat-lsp/dist/wasm/tree-sitter.wasm public/ && cp node_modules/vscode-oniguruma/release/onig.wasm public/ && cp ../vscode-extension/syntaxes/wat.tmLanguage.json public/",
    "dev": "vite",
    "build": "tsgo && vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@emnudge/wat-lsp": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.4",
    "monaco-editor": "^0.45.0",
    "monaco-editor-textmate": "^4.0.0",
    "pinia": "^3.0.4",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.1",
    "vue": "^3.5.27",
    "js-wasm-tools": "^1.3.1",
    "web-tree-sitter": "^0.25.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@typescript/native-preview": "^7.0.0-dev.20250129.1",
    "@vue/compiler-sfc": "^3.5.27",
    "vite": "^5.0.0"
  }
}
